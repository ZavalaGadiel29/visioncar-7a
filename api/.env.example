# Copia este archivo como .env (en la carpeta api/) y cambia los valores.
# .env NUNCA se sube a GitHub (está en .gitignore).
# Genera cada token con:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Tokens (mínimo 16 caracteres, los tres distintos) ---
TOKEN_CARRITO=cambia-esto-token-del-carrito
TOKEN_LECTURA=cambia-esto-token-de-lectura-web
TOKEN_APP=cambia-esto-token-de-la-app-movil

# --- PostgreSQL (Supabase) ---
# Si DATABASE_URL tiene valor, la API guarda en PostgreSQL y el modo demo se
# apaga solo (MODO_DEMO queda en 0 y /demo/generar no existe): solo datos reales.
# Cópiala de Supabase: Connect -> Session pooler (ver README, sección 4).
# Cambia [CONTRASENA] por la contraseña de tu base. Déjala vacía para usar memoria/MongoDB.
# DATABASE_URL=postgresql://postgres.abcdefghijklmnop:[CONTRASENA]@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# --- Modo demo (solo si DATABASE_URL está vacía): 1 = memoria, 0 = usa MongoDB Atlas ---
MODO_DEMO=1
# Eventos falsos que se crean al arrancar en modo demo (0 = ninguno)
DEMO_EVENTOS_INICIALES=100

# --- MongoDB Atlas (solo si MODO_DEMO=0) ---
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_BASE=visioncar

# --- Opcionales ---
# Orígenes permitidos para la web de 4° (separados por coma). * = cualquiera
CORS_ORIGENES=*
LIMITE_POR_SEGUNDO=20
TAMANO_MAXIMO_BYTES=524288
SEGUNDOS_VIGENCIA_MANUAL=2
ZONA_HORARIA=America/Mexico_City
