# Copia este archivo como .env y pon los valores reales.
# .env NO se sube a git (está en .gitignore).

# Token del carrito para la API (el mismo valor que TOKEN_CARRITO en Render)
TOKEN_CARRITO=pega-aqui-el-token-del-carrito

# Opcional: URL de la API (si no se pone, se usa nube.api_url de config.json)
# API_URL=https://visioncar-api.onrender.com
